{
  "name": "gik-service-providers",
  "version": "0.3.1",
  "description": "Individually imported host-managed service providers for GIK.",
  "type": "module",
  "license": "MIT",
  "author": "nsreehari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nsreehari/gik-service-providers.git"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "exports": {
    "./byok": {
      "types": "./dist/byok.d.ts",
      "import": "./dist/byok.js"
    },
    "./gemini-byok": {
      "types": "./dist/gemini-byok.d.ts",
      "import": "./dist/gemini-byok.js"
    },
    "./openai-byok": {
      "types": "./dist/openai-byok.d.ts",
      "import": "./dist/openai-byok.js"
    },
    "./market-quotes": {
      "types": "./dist/market-quotes.d.ts",
      "import": "./dist/market-quotes.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "import": "./dist/scheduler.js"
    },
    "./gmail": {
      "types": "./dist/gmail.d.ts",
      "import": "./dist/gmail.js"
    },
    "./github-context-store": {
      "types": "./dist/github-context-store.d.ts",
      "import": "./dist/github-context-store.js"
    },
    "./foundry": {
      "types": "./dist/foundry.d.ts",
      "import": "./dist/foundry.js"
    }
  },
  "dependencies": {
    "croner": "^9.1.0",
    "gik-agent-lifecycle-exp": ">=0.3.0",
    "gik-controlface": ">=0.7.0",
    "gik-kernel": ">=0.4.1"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node --test test/*.test.mjs",
    "test:package": "npm run release:pack",
    "release:validate": "node scripts/validate-npm-release.mjs",
    "release:gate": "npm run release:validate && npm run build && npm run typecheck && npm test",
    "release:pack": "node scripts/release-artifacts.mjs pack",
    "release:publish-artifacts": "node scripts/release-artifacts.mjs publish",
    "release:verify-published": "node scripts/verify-published-packages.mjs"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "4.1.10"
  },
  "packageManager": "npm@11.19.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
